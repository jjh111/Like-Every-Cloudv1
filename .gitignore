node_modules/
dist/
.vite/
.DS_Store
*.log

# Local-only MCP config (machine-specific server URLs).
.mcp.json

# User-marked working folders.
Working - gitignore/

# Source asset checkouts (Rhino/Blender working files, sample audio dumps).
# Heavy + machine-local; the canonical scene lives in public/scene/shared.glb.
assets/

# Director / concept docs — drafts and reference PDFs from the brief.
Concepts - Draft Text/
LIKE EVERY CLOUD concept document.pdf

# GLB exports — wildcard-ignored by default; everything actually consumed by
# the runtime is whitelisted below. When you ship a new hero, add its
# manifest entry AND add a `!` line here.
# Pre-KTX2 these are still chunky (~40 MB total used) but all individual
# files are well under GitHub's per-file warning threshold. Re-audit after
# the texture compression pass in Tier 2.
public/scene/*.glb
!public/scene/shared.glb
public/heroes/*.glb
!public/heroes/hero_boombox.glb
!public/heroes/hero_cassette_case.glb
!public/heroes/hero_cassette_raw_a.glb
!public/heroes/hero_cassette_raw_b.glb
!public/heroes/hero_chair.glb
!public/heroes/hero_table.glb
# Sound-emitting heroes — placeholders today (procedural spheres from
# scripts/make-placeholder-heroes.mjs), real GLBs to drop in later. Their
# manifest entry + states.json `heroAudio` config stays the same when the
# real geometry lands.
!public/heroes/hero_fan.glb
!public/heroes/hero_generator.glb
!public/heroes/hero_motorcycle.glb
!public/heroes/hero_sewing.glb

# Encoded SFX/ambient audio (output of `npm run compress-audio`). Sources
# live in `Working - gitignore/Sounds/` which is git-ignored above.
!public/audio/sfx/**/*.m4a
